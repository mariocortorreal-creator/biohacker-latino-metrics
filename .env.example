# Supabase (proyecto "biohacker-latino-metrics", separado de biohacker-score)
NEXT_PUBLIC_SUPABASE_URL=https://tqpjsnkhtzjqkcbwjpfh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Protege el endpoint /api/cron/sync — Vercel Cron manda este bearer token automáticamente
# si defines la misma variable CRON_SECRET en el proyecto de Vercel.
